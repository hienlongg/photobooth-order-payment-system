PROJECT_NAME="Photobooth Backend"
API_V1_STR="/api/v1"
SECRET_KEY="photobooth-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_SERVER=localhost
POSTGRES_PORT=15432
POSTGRES_USER=photobooth
POSTGRES_PASSWORD=photobooth_secure_pass
POSTGRES_DB=photobooth_db

# Tests drop/create ALL tables, so they must use a separate database whose name ends
# in "_test". Defaults to <POSTGRES_DB>_test (created automatically) when unset.
# TEST_DATABASE_URL=postgresql+asyncpg://photobooth:photobooth_secure_pass@localhost:15432/photobooth_db_test

# Payment Configuration
PAYOS_CLIENT_ID=fake-payos-client-id
PAYOS_API_KEY=fake-payos-api-key
PAYOS_CHECKSUM_KEY=fake_payos_checksum_key_for_testing
ORDER_PAYMENT_TIMEOUT_MINUTES=15
